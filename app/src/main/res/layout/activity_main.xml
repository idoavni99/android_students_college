<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_activity_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/gridSpot1"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@color/dark_theme_grey"
        app:layout_constraintEnd_toEndOf="@+id/gameNameView"
        app:layout_constraintHorizontal_bias="0.428"
        app:layout_constraintStart_toStartOf="@+id/gameNameView"
        app:layout_constraintTop_toBottomOf="@+id/gameNameView"
        android:layout_marginTop="80dp"
        tools:srcCompat="@drawable/red_x" />

    <ImageView
        android:id="@+id/gridSpot4"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="12dp"
        android:background="@color/dark_theme_grey"
        app:layout_constraintEnd_toEndOf="@+id/gridSpot1"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/gridSpot1"
        app:layout_constraintTop_toBottomOf="@+id/gridSpot1"
        tools:srcCompat="@drawable/red_x" />

    <ImageView
        android:id="@+id/gridSpot2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="12dp"
        android:background="@color/dark_theme_grey"
        app:layout_constraintBottom_toBottomOf="@+id/gridSpot1"
        app:layout_constraintStart_toEndOf="@+id/gridSpot1"
        app:layout_constraintTop_toTopOf="@+id/gridSpot1"
        tools:srcCompat="@drawable/red_x" />

    <ImageView
        android:id="@+id/gridSpot0"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginEnd="12dp"
        android:background="@color/dark_theme_grey"
        app:layout_constraintBottom_toBottomOf="@+id/gridSpot1"
        app:layout_constraintEnd_toStartOf="@+id/gridSpot1"
        app:layout_constraintTop_toTopOf="@+id/gridSpot1"
        tools:srcCompat="@drawable/red_x" />

    <ImageView
        android:id="@+id/gridSpot3"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginEnd="12dp"
        android:background="@color/dark_theme_grey"
        app:layout_constraintBottom_toBottomOf="@+id/gridSpot4"
        app:layout_constraintEnd_toStartOf="@+id/gridSpot4"
        app:layout_constraintTop_toTopOf="@+id/gridSpot4"
        tools:srcCompat="@drawable/red_x" />

    <ImageView
        android:id="@+id/gridSpot5"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="12dp"
        android:background="@color/dark_theme_grey"
        app:layout_constraintBottom_toBottomOf="@+id/gridSpot4"
        app:layout_constraintStart_toEndOf="@+id/gridSpot4"
        app:layout_constraintTop_toTopOf="@+id/gridSpot4"
        tools:srcCompat="@drawable/red_x" />

    <ImageView
        android:id="@+id/gridSpot6"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginEnd="12dp"
        android:background="@color/dark_theme_grey"
        app:layout_constraintBottom_toBottomOf="@+id/gridSpot7"
        app:layout_constraintEnd_toStartOf="@+id/gridSpot7"
        app:layout_constraintTop_toTopOf="@+id/gridSpot7"
        tools:srcCompat="@drawable/red_x" />

    <ImageView
        android:id="@+id/gridSpot8"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="12dp"
        android:background="@color/dark_theme_grey"
        app:layout_constraintBottom_toBottomOf="@+id/gridSpot7"
        app:layout_constraintStart_toEndOf="@+id/gridSpot7"
        app:layout_constraintTop_toTopOf="@+id/gridSpot7"
        tools:srcCompat="@drawable/red_x" />

    <ImageView
        android:id="@+id/gridSpot7"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="12dp"
        android:background="@color/dark_theme_grey"
        app:layout_constraintEnd_toEndOf="@+id/gridSpot4"
        app:layout_constraintStart_toStartOf="@+id/gridSpot4"
        app:layout_constraintTop_toBottomOf="@+id/gridSpot4"
        tools:srcCompat="@drawable/red_x" />

    <TextView
        android:id="@+id/gameNameView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:fontFamily="sans-serif-light"
        android:text="Tic-Tac-Toe"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        app:layout_constraintEnd_toEndOf="@+id/playButton"
        app:layout_constraintStart_toStartOf="@+id/playButton"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/playButton"
        android:layout_width="200dp"
        android:layout_height="100dp"
        android:backgroundTint="@color/dark_theme_grey"
        android:text="PLAY"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gridSpot7"
        tools:visibility="gone" />

    <TextView
        android:id="@+id/playerTurnDisplay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:fontFamily="sans-serif"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:textColor="@color/red"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gridSpot7"
        tools:text="Player One's turn"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>